---
import Layout from '../layouts/Layout.astro';
import GlassPrism from '../components/GlassPrism.astro';
---

<Layout
  title="Page Not Found (404) | BidWise Marketing"
  description="The page you are looking for does not exist or has been relocated."
  noindex={true}
>
  <section class="not-found-section section">
    <GlassPrism size={95} variant="cube" className="prism-float hero-prism-1" />
    <GlassPrism size={75} variant="prism" className="prism-float-reverse hero-prism-2" />

    <div class="container">
      <div class="glass-card not-found-card">
        <span class="error-badge">404 ERROR</span>
        <h1 class="error-title">Page Not Found</h1>
        <p class="error-desc">
          The requested URL does not exist or may have been updated during our architectural upgrade. Use the links below to find what you need.
        </p>

        <div class="quick-nav-box">
          <h2 class="quick-nav-title">Popular Destinations:</h2>
          <ul class="quick-nav-list">
            <li><a href="/">&rarr; Homepage</a></li>
            <li><a href="/services/">&rarr; Services Overview</a></li>
            <li><a href="/services/google-ads/">&rarr; Google Ads Management</a></li>
            <li><a href="/free-google-ads-audit/">&rarr; Free Google Ads Audit</a></li>
            <li><a href="/contact/">&rarr; Contact &amp; Consultation</a></li>
          </ul>
        </div>

        <div class="error-btn-row">
          <a href="/" class="btn btn-primary">Return Home</a>
          <a href="/contact/" class="btn btn-glass">Contact Support</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found-section {
    position: relative;
    padding-top: calc(var(--nav-height) + 60px);
    min-height: 80vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-prism-1 {
    top: 20%;
    left: 8%;
  }

  .hero-prism-2 {
    bottom: 15%;
    right: 8%;
  }

  .not-found-card {
    max-width: 620px;
    margin: 0 auto;
    padding: 56px 40px;
    text-align: center;
    background: rgba(8, 22, 38, 0.85);
  }

  .error-badge {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--cyan-primary);
    background: rgba(0, 242, 254, 0.1);
    border: 1px solid rgba(0, 242, 254, 0.3);
    padding: 6px 16px;
    border-radius: var(--radius-full);
    display: inline-block;
    margin-bottom: 20px;
  }

  .error-title {
    font-size: 2.4rem;
    color: #ffffff;
    margin-bottom: 14px;
  }

  .error-desc {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 32px;
  }

  .quick-nav-box {
    background: rgba(10, 26, 44, 0.6);
    border: 1px solid rgba(0, 242, 254, 0.18);
    border-radius: var(--radius-md);
    padding: 24px;
    text-align: left;
    margin-bottom: 32px;
  }

  .quick-nav-title {
    font-size: 0.95rem;
    color: #ffffff;
    margin-bottom: 14px;
  }

  .quick-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .quick-nav-list a {
    font-size: 0.9rem;
    color: var(--cyan-bright);
    transition: color 0.2s ease;
  }

  .quick-nav-list a:hover {
    color: #ffffff;
  }

  .error-btn-row {
    display: flex;
    justify-content: center;
    gap: 14px;
  }

  @media (max-width: 640px) {
    .not-found-card {
      padding: 36px 24px;
    }
    .error-btn-row {
      flex-direction: column;
    }
  }
</style>
