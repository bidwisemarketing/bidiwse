---
import Layout from '../../layouts/Layout.astro';
import { INSIGHTS_DATA } from '../../data/insights.data';
---

<Layout
  title="Insights & Research | Growth Marketing & Telemetry | BidWise Marketing"
  description="Actionable perspectives, technical checklists, and deep-dives on Google Ads audits, AEO/GEO generative search, and server-side tracking."
>
  <section class="insights-index-hero section">
    <div class="container">
      <div class="section-header" style="max-width: 760px;">
        <div class="glass-pill">
          <span class="dot"></span>
          <span>Knowledge &amp; Engineering</span>
        </div>
        <h1 style="margin-top: 16px;">
          Perspectives on <span class="text-gradient">Performance Growth</span>
        </h1>
        <p class="subtitle">
          No generic filler. We publish technical checklists, telemetry guides, and performance engineering frameworks written directly by our practitioners.
        </p>
      </div>

      <div class="grid-3 insights-catalog-grid">
        {INSIGHTS_DATA.map((article) => (
          <article class="glass-card insight-article-card">
            <div class="card-meta-top">
              <span class="cat-pill">{article.category}</span>
              <span class="read-time-pill">{article.readTime}</span>
            </div>

            <h2 class="card-article-title">
              <a href={`/insights/${article.slug}/`}>{article.title}</a>
            </h2>

            <p class="card-article-excerpt">{article.excerpt}</p>

            <div class="card-author-strip">
              <img 
                src={article.author.image} 
                alt={article.author.name} 
                width="36" 
                height="36" 
                class="author-thumb"
                loading="lazy"
                decoding="async"
              />
              <div class="author-details">
                <span class="author-name">{article.author.name}</span>
                <span class="publish-date">{article.date}</span>
              </div>
            </div>

            <a href={`/insights/${article.slug}/`} class="btn btn-glass btn-sm read-btn">
              <span>Read Full Article</span>
              <span>&rarr;</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .insights-index-hero {
    padding-top: calc(var(--nav-height) + 50px);
  }

  .insights-catalog-grid {
    margin-top: 20px;
  }

  .insight-article-card {
    display: flex;
    flex-direction: column;
    padding: 32px;
    background: rgba(8, 22, 38, 0.65);
    border: 1px solid rgba(0, 242, 254, 0.2);
  }

  .card-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .cat-pill {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--cyan-primary);
    background: rgba(0, 242, 254, 0.08);
    border: 1px solid rgba(0, 242, 254, 0.25);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .read-time-pill {
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  .card-article-title {
    font-size: 1.25rem;
    color: #ffffff;
    line-height: 1.35;
    margin-bottom: 12px;
  }

  .card-article-title a:hover {
    color: var(--cyan-bright);
  }

  .card-article-excerpt {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 24px;
    flex-grow: 1;
  }

  .card-author-strip {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 20px;
  }

  .author-thumb {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--cyan-primary);
  }

  .author-details {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: 0.84rem;
    font-weight: 700;
    color: #ffffff;
  }

  .publish-date {
    font-size: 0.74rem;
    color: var(--text-dim);
  }

  .read-btn {
    width: 100%;
    justify-content: space-between;
  }
</style>
