---
import Layout from '../layouts/Layout.astro';
import GlassPrism from '../components/GlassPrism.astro';
import { BRAND_CONFIG } from '../config/brand.config';

const type = Astro.url.searchParams.get('type') || 'contact';
const isAudit = type === 'audit';
---

<Layout
  title="Thank You | Request Received | BidWise Marketing"
  description="Your request has been successfully submitted to BidWise Marketing."
  noindex={true}
>
  <section class="confirmation-section section">
    <GlassPrism size={95} variant="cube" className="prism-float hero-prism-1" />
    <GlassPrism size={75} variant="diamond" className="prism-float-reverse hero-prism-2" />

    <div class="container">
      <div class="glass-card confirmation-card">
        <div class="success-icon-badge">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#00f2fe" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>

        <h1 class="confirmation-title">
          {isAudit ? 'Audit Request Accepted' : 'Inquiry Received Successfully'}
        </h1>

        <p class="confirmation-message">
          {isAudit ? (
            'Thank you for requesting a free Google Ads account audit. Our certified Google Partner team will inspect your account details and email you within 24 business hours with account review instructions.'
          ) : (
            'Thank you for contacting BidWise Marketing. Our senior team has received your message and will review your project requirements. You can expect a response within one business day.'
          )}
        </p>

        <div class="next-steps-card">
          <h2 class="next-steps-heading">What Happens Next:</h2>
          <div class="steps-list">
            <div class="step-item">
              <span class="step-idx">1</span>
              <div>
                <strong>Initial Review:</strong>
                <span>We evaluate your website, current marketing channels, and commercial goals.</span>
              </div>
            </div>
            <div class="step-item">
              <span class="step-idx">2</span>
              <div>
                <strong>Tailored Strategy:</strong>
                <span>We prepare concrete diagnostic feedback or initial scope recommendations.</span>
              </div>
            </div>
            <div class="step-item">
              <span class="step-idx">3</span>
              <div>
                <strong>Direct Consultation:</strong>
                <span>We connect directly with you to walk through findings and next steps.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="confirmation-actions">
          <a href="/" class="btn btn-primary">
            Return to Homepage
          </a>
          <a href={BRAND_CONFIG.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-glass">
            Need Faster Response? WhatsApp Us
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .confirmation-section {
    position: relative;
    padding-top: calc(var(--nav-height) + 60px);
    min-height: 80vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-prism-1 {
    top: 15%;
    left: 8%;
  }

  .hero-prism-2 {
    bottom: 15%;
    right: 8%;
  }

  .confirmation-card {
    max-width: 680px;
    margin: 0 auto;
    padding: 56px 40px;
    text-align: center;
    background: rgba(8, 22, 38, 0.85);
    border: 1px solid rgba(0, 242, 254, 0.35);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.7), 0 0 40px rgba(0, 242, 254, 0.15);
  }

  .success-icon-badge {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: rgba(0, 242, 254, 0.1);
    border: 2px solid var(--cyan-primary);
    box-shadow: 0 0 25px rgba(0, 242, 254, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px auto;
  }

  .confirmation-title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    color: #ffffff;
    margin-bottom: 16px;
  }

  .confirmation-message {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .next-steps-card {
    background: rgba(10, 26, 44, 0.6);
    border: 1px solid rgba(0, 242, 254, 0.2);
    border-radius: var(--radius-md);
    padding: 24px;
    text-align: left;
    margin-bottom: 36px;
  }

  .next-steps-heading {
    font-size: 1.05rem;
    color: #ffffff;
    margin-bottom: 16px;
  }

  .steps-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .step-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    font-size: 0.92rem;
  }

  .step-idx {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(0, 242, 254, 0.15);
    border: 1px solid var(--cyan-primary);
    color: var(--cyan-primary);
    font-size: 0.8rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .step-item strong {
    color: #ffffff;
    margin-right: 6px;
  }

  .step-item span {
    color: var(--text-muted);
  }

  .confirmation-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .confirmation-card {
      padding: 36px 24px;
    }
  }
</style>
