---
import Layout from '../../layouts/Layout.astro';
import { SERVICES_DATA } from '../../data/services.data';
import { BRAND_CONFIG } from '../../config/brand.config';

const allServices = Object.values(SERVICES_DATA);
const pillars = BRAND_CONFIG.navigation.servicePillars;
---

<Layout
  title="Our Services | Full-Service Growth & PPC Agency | BidWise Marketing"
  description="Explore our specialized digital growth capabilities: Paid Media (Google, Meta, TikTok, LinkedIn), Technical SEO, AEO/GEO, Web Development, and AI Automations."
>
  <div class="services-hero-section section">
    <div class="container">
      <div class="section-header" style="margin-bottom: 30px;">
        <div class="glass-pill">
          <span class="dot"></span>
          <span>Growth Engineering Services</span>
        </div>
        <h1 style="margin-top: 16px;">
          Full-Stack Marketing Engineered for <span class="text-gradient">Measurable ROI</span>
        </h1>
        <p class="subtitle">
          We combine high-intent buyer acquisition, authoritative organic search, conversion-first web design, and automated business workflows into an integrated revenue engine.
        </p>
      </div>
    </div>
  </div>

  <!-- Services Grouped by Pillar -->
  {pillars.map((pillar, pillarIdx) => {
    const pillarServices = allServices.filter(s => s.pillar === pillar.title);

    return (
      <section class="section pillar-group-section">
        <div class="container">
          <div class="pillar-group-header">
            <div class="pillar-group-badge">
              <span class="pillar-idx">Pillar 0{pillarIdx + 1}</span>
              <h2 class="pillar-group-title">{pillar.title}</h2>
            </div>
            <p class="pillar-group-desc">{pillar.description}</p>
          </div>

          <div class="grid-3 services-cards-grid">
            {pillarServices.map((service) => (
              <div class="glass-card service-overview-card">
                <div class="service-card-top">
                  <span class="service-badge-pill">{service.badge}</span>
                  <h3 class="service-card-title">
                    <a href={`/services/${service.slug}/`}>{service.title}</a>
                  </h3>
                  <p class="service-card-desc">{service.heroSubheadline}</p>
                </div>

                <div class="service-card-scope">
                  <h4 class="scope-header">Core Deliverables:</h4>
                  <ul class="scope-list">
                    {service.deliverables.slice(0, 3).map((item) => (
                      <li><span class="check-icon">✓</span> {item}</li>
                    ))}
                  </ul>
                </div>

                <div class="service-card-footer">
                  <a href={`/services/${service.slug}/`} class="btn btn-glass btn-sm service-learn-more">
                    <span>Explore Service</span>
                    <span>&rarr;</span>
                  </a>
                  <a href={`/contact/?service=${service.slug}`} class="btn btn-primary btn-sm service-inquire">
                    Inquire
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    );
  })}

  <!-- Bottom CTA to Free Audit -->
  <section class="section">
    <div class="container">
      <div class="glass-card services-cta-card">
        <div class="cta-inner">
          <div class="glass-pill">
            <span class="dot"></span>
            <span>Not Sure Where to Begin?</span>
          </div>
          <h2 style="margin: 14px 0;">Start with a Confidential Account Audit</h2>
          <p style="margin-bottom: 24px;">
            If you are currently running Google Ads or paid media, our certified Google Partner audit reveals exactly where budget is being wasted and what immediate fixes will lift performance.
          </p>
          <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
            <a href="/free-google-ads-audit/" class="btn btn-primary">
              Claim Free Google Ads Audit
            </a>
            <a href="/contact/" class="btn btn-glass">
              Schedule Strategic Consultation
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .services-hero-section {
    padding-top: calc(var(--nav-height) + 60px);
    padding-bottom: 30px;
    text-align: center;
  }

  .pillar-group-section {
    padding: 40px 0;
  }

  .pillar-group-header {
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(0, 242, 254, 0.2);
  }

  .pillar-group-badge {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }

  .pillar-idx {
    font-family: var(--font-mono);
    color: var(--cyan-primary);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .pillar-group-title {
    font-size: 1.85rem;
    color: #ffffff;
  }

  .pillar-group-desc {
    font-size: 1rem;
    color: var(--text-muted);
  }

  .service-overview-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 30px;
    background: rgba(8, 22, 38, 0.65);
    border: 1px solid rgba(0, 242, 254, 0.2);
  }

  .service-badge-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--cyan-primary);
    background: rgba(0, 242, 254, 0.1);
    border: 1px solid rgba(0, 242, 254, 0.25);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    margin-bottom: 14px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .service-card-title {
    font-size: 1.25rem;
    color: #ffffff;
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .service-card-title a:hover {
    color: var(--cyan-bright);
  }

  .service-card-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .service-card-scope {
    padding: 16px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 20px;
  }

  .scope-header {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    margin-bottom: 10px;
  }

  .scope-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .scope-list li {
    font-size: 0.82rem;
    color: var(--text-main);
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 1.4;
  }

  .check-icon {
    color: var(--cyan-primary);
    font-weight: bold;
  }

  .service-card-footer {
    display: flex;
    align-items: center;
    gap: 10px;
    justify-content: space-between;
  }

  .service-learn-more {
    flex: 1;
    justify-content: space-between;
  }

  .service-inquire {
    padding: 8px 16px;
  }

  .services-cta-card {
    text-align: center;
    padding: 56px 32px;
    background: radial-gradient(circle at 50% 50%, rgba(14, 38, 62, 0.85) 0%, rgba(6, 18, 30, 0.95) 100%);
    border: 1px solid rgba(0, 242, 254, 0.35);
  }

  .cta-inner {
    max-width: 640px;
    margin: 0 auto;
  }
</style>
