---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import GlassPrism from '../../components/GlassPrism.astro';
import { SERVICES_DATA, type ServiceDetail } from '../../data/services.data';
import { BRAND_CONFIG } from '../../config/brand.config';

export function getStaticPaths() {
  return Object.values(SERVICES_DATA).map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceDetail;
}

const { service } = Astro.props;

// Service Schema JSON-LD
const serviceSchema = {
  "@type": "Service",
  "@id": `${BRAND_CONFIG.domain}/services/${service.slug}/#service`,
  "name": service.title,
  "description": service.metaDescription,
  "provider": {
    "@id": `${BRAND_CONFIG.domain}/#organization`
  },
  "areaServed": ["United States"],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": service.title,
    "itemListElement": service.deliverables.map((item) => ({
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": item
      }
    }))
  }
};

const faqSchema = {
  "@type": "FAQPage",
  "@id": `${BRAND_CONFIG.domain}/services/${service.slug}/#faq`,
  "mainEntity": service.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<Layout
  title={service.metaTitle}
  description={service.metaDescription}
  type="service"
  schemaData={[serviceSchema, faqSchema]}
>
  <!-- Service Hero Section -->
  <section class="service-hero-section section">
    <GlassPrism size={85} variant="cube" className="prism-float service-prism-1" />
    <GlassPrism size={65} variant="prism" className="prism-float-reverse service-prism-2" />

    <div class="container">
      <div class="service-hero-inner">
        <!-- Breadcrumbs -->
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li aria-hidden="true">&rsaquo;</li>
            <li><a href="/services/">Services</a></li>
            <li aria-hidden="true">&rsaquo;</li>
            <li aria-current="page">{service.shortTitle}</li>
          </ol>
        </nav>

        <div class="glass-pill" style="margin-top: 14px;">
          <span class="dot"></span>
          <span>{service.badge}</span>
        </div>

        <h1 class="service-hero-h1">{service.heroHeadline}</h1>
        <p class="service-hero-lead">{service.heroSubheadline}</p>

        <div class="service-cta-actions">
          <a href="#inquire" class="btn btn-primary">
            Request Proposal for {service.shortTitle} &rarr;
          </a>
          {service.slug === 'google-ads' || service.slug === 'paid-advertising' ? (
            <a href="/free-google-ads-audit/" class="btn btn-glass">
              Claim Free Google Ads Audit
            </a>
          ) : (
            <a href="/contact/" class="btn btn-glass">
              Speak with a Specialist
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Problem Addressed & Ideal Client Profile -->
  <section class="section service-audience-section">
    <div class="container">
      <div class="grid-2">
        <!-- Problem Solved -->
        <div class="glass-card audience-card">
          <div class="audience-badge">
            <span class="badge-icon">⚠️</span>
            <h2 class="audience-heading">The Core Challenge We Solve</h2>
          </div>
          <p class="audience-desc">{service.problemSolved}</p>
        </div>

        <!-- Who This Is Suited For -->
        <div class="glass-card audience-card">
          <div class="audience-badge">
            <span class="badge-icon">🎯</span>
            <h2 class="audience-heading">Who This Service Is Engineered For</h2>
          </div>
          <ul class="who-for-list">
            {service.whoFor.map((item) => (
              <li>
                <span class="check-icon">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Concrete Scope & Deliverables -->
  <section class="section service-scope-section">
    <div class="container">
      <div class="section-header">
        <div class="glass-pill">
          <span class="dot"></span>
          <span>Scope &amp; Deliverables</span>
        </div>
        <h2 style="margin-top: 14px;">What You Receive &amp; How We Deliver It</h2>
        <p class="subtitle">
          Transparent, verifiable scope items without vague promises or inflated agency jargon.
        </p>
      </div>

      <div class="grid-2">
        <div class="glass-card scope-box">
          <h3 class="box-title">Ongoing Execution Scope</h3>
          <ul class="deliverable-list">
            {service.scopeList.map((item) => (
              <li>
                <span class="bullet-dot">●</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="glass-card scope-box">
          <h3 class="box-title">Tangible Deliverables &amp; Assets</h3>
          <ul class="deliverable-list">
            {service.deliverables.map((item) => (
              <li>
                <span class="bullet-dot">●</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Realistic 5-Step Process -->
  <section class="section service-process-section">
    <div class="container">
      <div class="section-header">
        <div class="glass-pill">
          <span class="dot"></span>
          <span>Collaboration Framework</span>
        </div>
        <h2 style="margin-top: 14px;">How We Work Together</h2>
        <p class="subtitle">
          A disciplined, phased methodology that protects your capital and aligns every stage with business milestones.
        </p>
      </div>

      <div class="process-steps-grid">
        {service.process.map((step) => (
          <div class="glass-card process-step-card">
            <div class="step-num">{step.step}</div>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Platforms, Metrics & Scope Boundaries -->
  <section class="section service-tech-metrics-section">
    <div class="container">
      <div class="section-header">
        <div class="glass-pill">
          <span class="dot"></span>
          <span>Technical Framework</span>
        </div>
        <h2 style="margin-top: 14px;">Tools, Metrics &amp; Scope Boundaries</h2>
        <p class="subtitle">Complete technical visibility and operational parameters.</p>
      </div>

      <div class="grid-3">
        <!-- Tools & Platforms -->
        <div class="glass-card tech-card">
          <h3 class="card-subtitle">Tools &amp; Platforms</h3>
          <div class="tags-cloud">
            {service.platformsAndTools.map((tool) => (
              <span class="tech-tag">{tool}</span>
            ))}
          </div>
        </div>

        <!-- Success Measurement -->
        <div class="glass-card tech-card">
          <h3 class="card-subtitle">How We Measure Success</h3>
          <ul class="metrics-list">
            {service.metricsAndMeasurement.map((metric) => (
              <li><span class="check-icon">📊</span> {metric}</li>
            ))}
          </ul>
        </div>

        <!-- Scope Boundaries -->
        <div class="glass-card tech-card">
          <h3 class="card-subtitle">Scope Boundaries &amp; Prerequisite</h3>
          <p class="boundary-text">{service.boundaries}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service-Specific FAQs -->
  <section class="section service-faq-section">
    <div class="container">
      <div class="section-header">
        <div class="glass-pill">
          <span class="dot"></span>
          <span>Service FAQs</span>
        </div>
        <h2 style="margin-top: 14px;">Frequently Asked Questions</h2>
        <p class="subtitle">Straightforward answers about our {service.shortTitle} capabilities.</p>
      </div>

      <div class="faq-accordion-list">
        {service.faqs.map((faq, index) => (
          <details class="glass-card faq-card" open={index === 0}>
            <summary class="faq-summary">
              <span class="faq-question">{faq.q}</span>
              <span class="faq-toggle-icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-content">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Pre-selected Contact Form Section -->
  <section class="section" id="inquire">
    <div class="container">
      <ContactForm preselectedService={service.slug} />
    </div>
  </section>

  <!-- Related Services Links -->
  <section class="section related-services-section">
    <div class="container">
      <div class="section-header">
        <div class="glass-pill">
          <span class="dot"></span>
          <span>Connected Growth</span>
        </div>
        <h2 style="margin-top: 14px;">Related Growth Services</h2>
      </div>

      <div class="grid-3">
        {service.relatedServices.map((rel) => (
          <div class="glass-card related-card">
            <h3 class="related-title">
              <a href={`/services/${rel.slug}/`}>{rel.title}</a>
            </h3>
            <p class="related-desc">{rel.desc}</p>
            <a href={`/services/${rel.slug}/`} class="related-link">
              Explore Capability &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .service-hero-section {
    position: relative;
    padding-top: calc(var(--nav-height) + 60px);
    padding-bottom: 50px;
    overflow: hidden;
  }

  .service-prism-1 {
    top: 15%;
    right: 5%;
  }

  .service-prism-2 {
    bottom: 10%;
    left: 4%;
  }

  .service-hero-inner {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .breadcrumbs ol {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    font-size: 0.84rem;
    color: var(--text-dim);
  }

  .breadcrumbs a {
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .breadcrumbs a:hover {
    color: var(--cyan-primary);
  }

  .service-hero-h1 {
    font-size: clamp(2.2rem, 4.8vw, 3.8rem);
    margin: 18px 0 16px 0;
    line-height: 1.15;
  }

  .service-hero-lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 28px;
  }

  .service-cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .audience-card {
    padding: 32px;
    height: 100%;
  }

  .audience-badge {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .audience-badge h2,
  .audience-badge h3 {
    font-size: 1.25rem;
    color: #ffffff;
    font-weight: 700;
  }

  .badge-icon {
    font-size: 1.4rem;
  }

  .audience-desc {
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .who-for-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .who-for-list li {
    font-size: 0.92rem;
    color: var(--text-main);
    display: flex;
    align-items: flex-start;
    gap: 10px;
    line-height: 1.5;
  }

  .check-icon {
    color: var(--cyan-primary);
    font-weight: bold;
  }

  .scope-box {
    padding: 32px;
  }

  .box-title {
    font-size: 1.25rem;
    color: #ffffff;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(0, 242, 254, 0.2);
  }

  .deliverable-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .deliverable-list li {
    font-size: 0.9375rem;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    line-height: 1.5;
  }

  .bullet-dot {
    color: var(--cyan-primary);
    font-size: 0.8rem;
    margin-top: 3px;
  }

  .process-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }

  .process-step-card {
    padding: 24px;
    display: flex;
    flex-direction: column;
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--cyan-primary);
    margin-bottom: 10px;
  }

  .step-title {
    font-size: 1.05rem;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .step-desc {
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .tech-card {
    padding: 28px;
  }

  .card-subtitle {
    font-size: 1.15rem;
    color: #ffffff;
    margin-bottom: 16px;
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tech-tag {
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    background: rgba(0, 242, 254, 0.08);
    border: 1px solid rgba(0, 242, 254, 0.25);
    color: var(--cyan-bright);
  }

  .metrics-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .metrics-list li {
    font-size: 0.88rem;
    color: var(--text-main);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .boundary-text {
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 860px;
    margin: 0 auto;
  }

  .faq-card {
    padding: 20px 28px;
    cursor: pointer;
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    list-style: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-toggle-icon {
    font-size: 1.5rem;
    color: var(--cyan-primary);
  }

  .faq-content {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .faq-content p {
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .related-card {
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .related-title {
    font-size: 1.15rem;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .related-desc {
    font-size: 0.88rem;
    margin-bottom: 16px;
  }

  .related-link {
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--cyan-bright);
  }
</style>
