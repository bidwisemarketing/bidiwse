---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import GlassPrism from '../components/GlassPrism.astro';
import { BRAND_CONFIG } from '../config/brand.config';

const selectedService = Astro.url.searchParams.get('service') || '';
---

<Layout
  title="Contact BidWise Marketing | Discuss Your Growth Project"
  description="Get in touch with BIDWISE MARKETING. Direct consultation with certified Google Partner specialists. Verified Delaware headquarters, telephone, email, and WhatsApp."
>
  <section class="contact-page-section section">
    <GlassPrism size={90} variant="cube" className="prism-float hero-prism-1" />
    <GlassPrism size={70} variant="prism" className="prism-float-reverse hero-prism-2" />

    <div class="container">
      <div class="section-header" style="max-width: 760px;">
        <div class="glass-pill">
          <span class="dot"></span>
          <span>Direct Senior Consultation</span>
        </div>
        <h1 style="margin-top: 16px;">
          Let's Engineer Your <span class="text-gradient">Growth Engine</span>
        </h1>
        <p class="subtitle">
          Whether you need a specialized audit of your Google Ads, a multi-channel paid media architecture, or an ultra-fast web build, we respond promptly with actionable insights.
        </p>
      </div>

      <div class="contact-page-grid">
        <!-- Left: Direct Channels & Verified Details -->
        <div class="contact-sidebar">
          <div class="glass-card direct-channels-card">
            <h2 class="channel-card-title">Corporate &amp; Contact Details</h2>
            <p class="channel-card-desc">Connect directly with our senior performance marketing team.</p>

            <div class="channels-list">
              <a href={`tel:${BRAND_CONFIG.contact.phoneTel}`} class="channel-item">
                <div class="channel-icon-box">📞</div>
                <div class="channel-text">
                  <span class="channel-label">Telephone</span>
                  <span class="channel-val">{BRAND_CONFIG.contact.phoneDisplay}</span>
                </div>
              </a>

              <a href={`mailto:${BRAND_CONFIG.contact.email}`} class="channel-item">
                <div class="channel-icon-box">✉️</div>
                <div class="channel-text">
                  <span class="channel-label">Email Inquiries</span>
                  <span class="channel-val">{BRAND_CONFIG.contact.email}</span>
                </div>
              </a>

              <a href={BRAND_CONFIG.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="channel-item channel-item-wa">
                <div class="channel-icon-box wa-box">💬</div>
                <div class="channel-text">
                  <span class="channel-label">WhatsApp Direct</span>
                  <span class="channel-val text-cyan">Chat on WhatsApp &rarr;</span>
                </div>
              </a>

              <div class="channel-item static-item">
                <div class="channel-icon-box">📍</div>
                <div class="channel-text">
                  <span class="channel-label">Delaware Headquarters</span>
                  <span class="channel-val">{BRAND_CONFIG.contact.address.street}, {BRAND_CONFIG.contact.address.city}, {BRAND_CONFIG.contact.address.state} {BRAND_CONFIG.contact.address.postalCode}</span>
                </div>
              </div>

              <div class="channel-item static-item">
                <div class="channel-icon-box">⏱️</div>
                <div class="channel-text">
                  <span class="channel-label">Business Hours</span>
                  <span class="channel-val">{BRAND_CONFIG.contact.hours}</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Free Audit Shortcut -->
          <div class="glass-card audit-shortcut-card">
            <span class="shortcut-tag">Looking for an Ad Account Review?</span>
            <h3 class="shortcut-title">Claim Our Free Google Ads Audit</h3>
            <p class="shortcut-desc">
              If you are already spending on Google Ads, our manual audit uncovers exact query leaks and ROAS opportunities.
            </p>
            <a href="/free-google-ads-audit/" class="btn btn-primary btn-sm" style="width: 100%;">
              Go to Free Ads Audit &rarr;
            </a>
          </div>
        </div>

        <!-- Right: Contact Form -->
        <div class="contact-form-area">
          <ContactForm preselectedService={selectedService} />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-page-section {
    position: relative;
    padding-top: calc(var(--nav-height) + 50px);
    overflow: hidden;
  }

  .hero-prism-1 {
    top: 14%;
    right: 4%;
  }

  .hero-prism-2 {
    bottom: 10%;
    left: 4%;
  }

  .contact-page-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.2fr;
    gap: 40px;
    align-items: flex-start;
  }

  .direct-channels-card {
    padding: 32px;
    background: rgba(8, 22, 38, 0.75);
    margin-bottom: 24px;
  }

  .channel-card-title {
    font-size: 1.3rem;
    color: #ffffff;
    margin-bottom: 6px;
  }

  .channel-card-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .channels-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .channel-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-radius: var(--radius-md);
    background: rgba(10, 26, 44, 0.5);
    border: 1px solid rgba(0, 242, 254, 0.15);
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .channel-item:hover {
    background: rgba(14, 38, 64, 0.8);
    border-color: var(--cyan-primary);
    transform: translateX(4px);
  }

  .static-item:hover {
    transform: none;
    border-color: rgba(0, 242, 254, 0.15);
  }

  .channel-icon-box {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(0, 242, 254, 0.1);
    border: 1px solid rgba(0, 242, 254, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .wa-box {
    background: rgba(37, 211, 102, 0.15);
    border-color: rgba(37, 211, 102, 0.4);
  }

  .channel-text {
    display: flex;
    flex-direction: column;
  }

  .channel-label {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    font-weight: 600;
  }

  .channel-val {
    font-size: 0.92rem;
    font-weight: 600;
    color: #ffffff;
  }

  .audit-shortcut-card {
    padding: 28px;
    background: rgba(10, 26, 44, 0.65);
    border: 1px solid rgba(0, 242, 254, 0.25);
  }

  .shortcut-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--cyan-primary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: block;
    margin-bottom: 6px;
  }

  .shortcut-title {
    font-size: 1.15rem;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .shortcut-desc {
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 16px;
  }

  @media (max-width: 1024px) {
    .contact-page-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
