---
import Layout from '../layouts/Layout.astro';
import GlassPrism from '../components/GlassPrism.astro';
import { BRAND_CONFIG } from '../config/brand.config';

const agencyPrinciples = [
  {
    icon: '🎯',
    title: 'Senior-Level Execution Only',
    desc: 'At traditional agencies, senior pitch teams hand your budget off to inexperienced junior account coordinators. At BidWise Marketing, you collaborate directly with certified Google Partner specialists and senior performance marketers.'
  },
  {
    icon: '📊',
    title: 'Transparent, Uncompromised Data',
    desc: 'You maintain 100% ownership of your ad accounts, pixels, Google Tag Manager containers, and analytics properties. We never hide behind proprietary black boxes or obscure reporting.'
  },
  {
    icon: '🛡️',
    title: 'Telemetry & Signal Discipline',
    desc: 'Algorithmic Smart Bidding is only as good as the conversion signals fed into it. We prioritize server-side event tracking, Enhanced Conversions, and Google Consent Mode v2.'
  },
  {
    icon: '⚡',
    title: 'Performance & Engineering Standards',
    desc: 'We treat page speed, mobile accessibility, and clean architecture as engineering mandates. A 100ms improvement in page speed directly compounds your conversion rate.'
  }
];
---

<Layout
  title="About BidWise Marketing | Performance Growth Agency"
  description="Learn about BidWise Marketing. Over 9 years of hands-on PPC optimization and 700+ businesses scaled internationally by certified Google Partner specialists."
>
  <section class="about-hero-section section">
    <GlassPrism size={85} variant="cube" className="prism-float hero-prism-1" />
    <GlassPrism size={65} variant="prism" className="prism-float-reverse hero-prism-2" />

    <div class="container">
      <div class="section-header" style="max-width: 800px;">
        <div class="glass-pill">
          <span class="dot"></span>
          <span>Senior-Led Agency</span>
        </div>
        <h1 style="margin-top: 16px;">
          Built on Proven Expertise, Not <span class="text-gradient">Agency Overhead</span>
        </h1>
        <p class="subtitle">
          BidWise Marketing was established to provide ambitious brands with direct, senior-level performance marketing and digital engineering—without the bloat, complacency, or junior hand-offs of traditional holding agencies.
        </p>
      </div>

      <!-- Founder Showcase Story Card -->
      <div class="glass-card founder-profile-card">
        <div class="founder-profile-grid">
          <div class="founder-image-col">
            <div class="profile-frame">
              <picture>
                <source srcset="/hero-portrait.webp" type="image/webp" />
                <img 
                  src={BRAND_CONFIG.founder.image} 
                  alt="Certified Google Partner & Senior Growth Specialists at BidWise Marketing" 
                  width="340"
                  height="340"
                  class="founder-large-img"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <div class="founder-frame-glow"></div>
            </div>
            <div class="founder-badge-row">
              <span class="badge-tag">Google Partner Certified</span>
              <span class="badge-tag">GTM Accredited</span>
            </div>
          </div>

          <div class="founder-text-col">
            <h2 class="founder-headline">Senior Growth Engineering</h2>
            <span class="founder-position">Certified Google Partner Performance Specialists</span>

            <p class="founder-bio-p">
              With nearly a decade of continuous, hands-on optimization across Google Ads, Google Tag Manager, and multi-channel acquisition, our senior specialists have managed and scaled media budgets for over 700 businesses throughout the United States and globally.
            </p>

            <p class="founder-bio-p">
              Having witnessed how conventional marketing agencies dilute client budgets through layers of account managers, misconfigured conversion pixels, and loose search match types, BIDWISE MARKETING was architected around a single standard: <strong>rigorous, mathematical accountability for every advertising dollar spent.</strong>
            </p>

            <div class="profile-stats-grid">
              <div class="stat-box">
                <span class="stat-val">9+</span>
                <span class="stat-lbl">Years Experience</span>
              </div>
              <div class="stat-box">
                <span class="stat-val">700+</span>
                <span class="stat-lbl">Accounts Scaled</span>
              </div>
              <div class="stat-box">
                <span class="stat-val">100%</span>
                <span class="stat-lbl">Senior Execution</span>
              </div>
            </div>

            <div class="founder-actions">
              <a href="/free-google-ads-audit/" class="btn btn-primary">
                Claim Free Ads Audit
              </a>
              <a href={BRAND_CONFIG.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-glass">
                WhatsApp: +1 302 626 7596
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Operating Principles -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div class="glass-pill">
          <span class="dot"></span>
          <span>Our Standards</span>
        </div>
        <h2 style="margin-top: 14px;">How We Operate &amp; What We Stand For</h2>
        <p class="subtitle">
          Four foundational commitments that govern every engagement, audit, and campaign build.
        </p>
      </div>

      <div class="grid-2">
        {agencyPrinciples.map((item) => (
          <div class="glass-card principle-card">
            <span class="principle-icon">{item.icon}</span>
            <h3 class="principle-title">{item.title}</h3>
            <p class="principle-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Verified Business Information Strip -->
  <section class="section">
    <div class="container">
      <div class="glass-card verified-info-card">
        <h2 class="info-card-title">Verified Corporate &amp; Contact Details</h2>
        <p class="info-card-subtitle">Official operational business and corporate contact information.</p>

        <div class="info-details-grid">
          <div class="info-item">
            <span class="info-label">Company Name</span>
            <span class="info-val"><strong>{BRAND_CONFIG.legalName}</strong></span>
          </div>
          <div class="info-item">
            <span class="info-label">Accreditations</span>
            <span class="info-val">Certified Google Partner &amp; GTM Accredited</span>
          </div>
          <div class="info-item">
            <span class="info-label">Corporate Address</span>
            <span class="info-val">{BRAND_CONFIG.contact.address.street}, {BRAND_CONFIG.contact.address.city}, {BRAND_CONFIG.contact.address.state} {BRAND_CONFIG.contact.address.postalCode}</span>
          </div>
          <div class="info-item">
            <span class="info-label">Contact / WhatsApp</span>
            <span class="info-val"><a href={`tel:${BRAND_CONFIG.contact.phoneTel}`}>{BRAND_CONFIG.contact.phoneDisplay}</a></span>
          </div>
          <div class="info-item">
            <span class="info-label">Email</span>
            <span class="info-val"><a href={`mailto:${BRAND_CONFIG.contact.email}`}>{BRAND_CONFIG.contact.email}</a></span>
          </div>
          <div class="info-item">
            <span class="info-label">Business Hours</span>
            <span class="info-val">{BRAND_CONFIG.contact.hours}</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-hero-section {
    position: relative;
    padding-top: calc(var(--nav-height) + 50px);
    overflow: hidden;
  }

  .hero-prism-1 {
    top: 14%;
    left: 4%;
  }

  .hero-prism-2 {
    bottom: 12%;
    right: 4%;
  }

  .founder-profile-card {
    padding: 44px;
    background: rgba(8, 22, 38, 0.75);
    border: 1px solid rgba(0, 242, 254, 0.28);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.65);
    margin-top: 20px;
  }

  .founder-profile-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 48px;
    align-items: center;
  }

  .profile-frame {
    position: relative;
    width: 100%;
    max-width: 340px;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(0, 242, 254, 0.3);
    background: rgba(6, 18, 30, 0.8);
  }

  .founder-large-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .founder-badge-row {
    display: flex;
    gap: 8px;
    margin-top: 14px;
    flex-wrap: wrap;
  }

  .badge-tag {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--cyan-primary);
    background: rgba(0, 242, 254, 0.1);
    border: 1px solid rgba(0, 242, 254, 0.25);
    padding: 4px 10px;
    border-radius: var(--radius-full);
  }

  .founder-headline {
    font-size: 2.2rem;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .founder-position {
    display: block;
    font-size: 0.95rem;
    color: var(--cyan-bright);
    font-weight: 600;
    margin-bottom: 20px;
  }

  .founder-bio-p {
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 16px;
    color: var(--text-muted);
  }

  .founder-bio-p strong {
    color: #ffffff;
  }

  .profile-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 24px 0;
    padding: 18px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .stat-box {
    display: flex;
    flex-direction: column;
  }

  .stat-val {
    font-size: 1.6rem;
    font-weight: 800;
    color: #ffffff;
  }

  .stat-lbl {
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  .founder-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .principle-card {
    padding: 32px;
  }

  .principle-icon {
    font-size: 2rem;
    margin-bottom: 14px;
    display: block;
  }

  .principle-title {
    font-size: 1.25rem;
    color: #ffffff;
    margin-bottom: 10px;
  }

  .principle-desc {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* Verified Info Card */
  .verified-info-card {
    padding: 36px;
    background: rgba(6, 18, 30, 0.7);
  }

  .info-card-title {
    font-size: 1.3rem;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .info-card-subtitle {
    font-size: 0.88rem;
    color: var(--text-dim);
    margin-bottom: 24px;
  }

  .info-details-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .info-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .info-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
    font-weight: 600;
  }

  .info-val {
    font-size: 0.92rem;
    color: var(--text-main);
  }

  .info-val a {
    color: var(--cyan-bright);
  }

  @media (max-width: 1024px) {
    .founder-profile-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .profile-frame {
      margin: 0 auto;
    }
    .founder-badge-row {
      justify-content: center;
    }
    .profile-stats-grid {
      justify-content: center;
    }
    .founder-actions {
      justify-content: center;
    }
    .info-details-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .info-details-grid {
      grid-template-columns: 1fr;
    }
    .founder-profile-card {
      padding: 24px;
    }
  }
</style>
