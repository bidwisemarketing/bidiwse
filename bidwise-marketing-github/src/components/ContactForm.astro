---
import { BRAND_CONFIG } from '../config/brand.config';

interface Props {
  preselectedService?: string;
}

const { preselectedService = '' } = Astro.props;

const serviceOptions = [
  { value: 'paid-advertising', label: 'Paid Advertising Hub (Cross-Channel)' },
  { value: 'google-ads', label: 'Google Ads Management & PPC' },
  { value: 'meta-ads', label: 'Meta Ads (Facebook & Instagram)' },
  { value: 'tiktok-ads', label: 'TikTok Ads & Short-Form Video' },
  { value: 'linkedin-ads', label: 'LinkedIn B2B Advertising' },
  { value: 'seo', label: 'Technical & Organic SEO' },
  { value: 'aeo-geo', label: 'AEO & GEO (AI Answer Engines)' },
  { value: 'social-media-marketing', label: 'Social Media Marketing' },
  { value: 'content-marketing', label: 'Content Marketing Strategy' },
  { value: 'email-marketing', label: 'Email & Lifecycle Marketing' },
  { value: 'web-design', label: 'Web Design & Development' },
  { value: 'app-design', label: 'App & Product UI/UX Design' },
  { value: 'ai-automation', label: 'AI Business Automations' },
  { value: 'conversion-rate-optimisation', label: 'Conversion Rate Optimisation (CRO)' },
  { value: 'analytics-tracking', label: 'Analytics & Server-Side Tracking' },
  { value: 'other', label: 'General Project Discussion' }
];
---

<div class="glass-card contact-form-card">
  <div class="form-header">
    <div class="glass-pill">
      <span class="dot"></span>
      <span>Direct Project Inquiry</span>
    </div>
    <h2 class="form-main-title">Discuss Your Growth Project</h2>
    <p class="form-desc">
      Share your project goals. You will speak directly with senior leadership to map out scope, deliverables, and commercial terms.
    </p>
  </div>

  <form id="projectContactForm" class="contact-form" method="POST" action="/api/contact">
    <!-- Honeypot anti-spam field -->
    <div style="display: none;" aria-hidden="true">
      <label for="contact_botField">Do not fill this</label>
      <input type="text" id="contact_botField" name="botField" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form-row">
      <div class="form-group" style="flex: 1;">
        <label for="contact_name" class="form-label">Full Name <span class="text-cyan">*</span></label>
        <input type="text" id="contact_name" name="name" class="form-input" placeholder="e.g. Alex Morgan" required />
      </div>

      <div class="form-group" style="flex: 1;">
        <label for="contact_email" class="form-label">Work Email <span class="text-cyan">*</span></label>
        <input type="email" id="contact_email" name="email" class="form-input" placeholder="alex@company.com" required />
      </div>
    </div>

    <div class="form-row">
      <div class="form-group" style="flex: 1;">
        <label for="contact_website" class="form-label">Website or Company URL <span class="text-cyan">*</span></label>
        <input type="url" id="contact_website" name="website" class="form-input" placeholder="https://company.com" required />
      </div>

      <div class="form-group" style="flex: 1;">
        <label for="contact_phone" class="form-label">Phone Number (Optional)</label>
        <input type="tel" id="contact_phone" name="phone" class="form-input" placeholder="+44 7000 000000" />
      </div>
    </div>

    <div class="form-group">
      <label for="contact_service" class="form-label">Primary Service Interest <span class="text-cyan">*</span></label>
      <select id="contact_service" name="service" class="form-select" required>
        <option value="" disabled selected={!preselectedService}>Select a service...</option>
        {serviceOptions.map((opt) => (
          <option value={opt.value} selected={preselectedService === opt.value}>
            {opt.label}
          </option>
        ))}
      </select>
    </div>

    <div class="form-group">
      <label for="contact_message" class="form-label">Project Details &amp; Objectives <span class="text-cyan">*</span></label>
      <textarea 
        id="contact_message" 
        name="message" 
        class="form-textarea" 
        rows="4" 
        placeholder="Describe your current bottleneck, target metrics, timeline, and current marketing spend..." 
        required
      ></textarea>
    </div>

    <div class="form-footer-actions">
      <button type="submit" id="contactSubmitBtn" class="btn btn-primary" style="flex: 1;">
        <span>Send Project Inquiry</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>

      <a href={BRAND_CONFIG.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-glass" style="flex: 0 0 auto;">
        <span>Instant WhatsApp</span>
      </a>
    </div>

    <div id="contactFormStatus" class="form-status-message" aria-live="polite"></div>

    <p class="privacy-notice">
      By submitting, you agree to our <a href="/privacy/" class="text-cyan">Privacy Policy</a>. We never sell personal data or spam your inbox.
    </p>
  </form>
</div>

<style>
  .contact-form-card {
    background: rgba(8, 22, 38, 0.75);
    border: 1px solid rgba(0, 242, 254, 0.28);
    padding: 44px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
  }

  .form-header {
    margin-bottom: 30px;
  }

  .form-main-title {
    font-size: 1.8rem;
    color: #ffffff;
    margin: 14px 0 8px 0;
  }

  .form-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .form-row {
    display: flex;
    gap: 18px;
  }

  .form-footer-actions {
    display: flex;
    gap: 14px;
    margin-top: 14px;
    flex-wrap: wrap;
  }

  .privacy-notice {
    font-size: 0.8rem;
    color: var(--text-dim);
    margin-top: 18px;
    text-align: center;
  }

  .form-status-message {
    margin-top: 16px;
    font-size: 0.875rem;
    text-align: center;
    padding: 12px;
    border-radius: var(--radius-sm);
    display: none;
  }

  .form-status-message.success {
    display: block;
    background: rgba(16, 185, 129, 0.2);
    border: 1px solid #10b981;
    color: #6ee7b7;
  }

  .form-status-message.error {
    display: block;
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid #ef4444;
    color: #fca5a5;
  }

  @media (max-width: 640px) {
    .contact-form-card {
      padding: 24px;
    }
    .form-row {
      flex-direction: column;
      gap: 0;
    }
    .form-footer-actions {
      flex-direction: column;
    }
  }
</style>

<script>
  function setupContactForm() {
    const form = document.getElementById('projectContactForm') as HTMLFormElement | null;
    const btn = document.getElementById('contactSubmitBtn') as HTMLButtonElement | null;
    const statusBox = document.getElementById('contactFormStatus');

    if (!form || !btn || !statusBox) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      // Honeypot check
      if (data.botField) {
        return;
      }

      btn.disabled = true;
      const originalText = btn.innerHTML;
      btn.innerHTML = '<span>Sending Message...</span>';
      statusBox.className = 'form-status-message';
      statusBox.style.display = 'none';

      try {
        let isSuccess = false;
        let errorMessage = '';

        try {
          const response = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });

          const result = await response.json().catch(() => null);

          if (response.ok && result?.success) {
            isSuccess = true;
          } else {
            errorMessage = result?.error || 'Server error';
          }
        } catch (fetchErr) {
          console.warn('[BidWise] Primary contact endpoint unavailable, engaging direct backup...', fetchErr);
        }

        // Resilient fallback: If server route did not return success, submit directly to FormSubmit
        if (!isSuccess) {
          try {
            const fallbackRes = await fetch('https://formsubmit.co/ajax/mohammadbilal671@gmail.com', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
              },
              body: JSON.stringify({
                _subject: `[BidWise Marketing] New Project Inquiry: ${data.name} (${data.service || 'General'})`,
                _replyto: data.email,
                _autoresponse: 'Thank you for contacting BidWise Marketing! Our certified Google Partner team has received your project inquiry and will follow up within 24 business hours.',
                _template: 'table',
                _captcha: 'false',
                'Client Name': data.name,
                'Work Email': data.email,
                'Company Website': data.website,
                'Phone': data.phone || 'Not provided',
                'Service': data.service || 'General',
                'Project Details': data.message,
                'Submitted At': new Date().toISOString(),
                'Source': 'BidWise Marketing Contact Form',
              }),
            });
            const fbResult = await fallbackRes.json().catch(() => null);
            if (fallbackRes.ok && (fbResult?.success === 'true' || fbResult?.success === true)) {
              isSuccess = true;
            }
          } catch (fbErr) {
            console.error('[BidWise] Backup submission failed:', fbErr);
          }
        }

        if (isSuccess) {
          statusBox.textContent = '✓ Message received! Our senior team will review your project and get back to you shortly.';
          statusBox.className = 'form-status-message success';
          statusBox.style.display = 'block';
          form.reset();
          setTimeout(() => {
            window.location.href = '/confirmation/?type=contact';
          }, 1500);
        } else {
          throw new Error(errorMessage || 'Submission could not be completed. Please email info@bidwise.marketing directly.');
        }
      } catch (err: any) {
        statusBox.textContent = err.message || 'Error sending message. Please reach out to info@bidwise.marketing.';
        statusBox.className = 'form-status-message error';
        statusBox.style.display = 'block';
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
