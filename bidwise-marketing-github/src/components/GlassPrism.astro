---
export interface Props {
  size?: number;
  className?: string;
  style?: string;
  variant?: 'cube' | 'prism' | 'diamond';
}

const { size = 80, className = '', style = '', variant = 'cube' } = Astro.props;
---

<div class={`prism-wrapper ${className}`} style={`width: ${size}px; height: ${size}px; ${style}`} aria-hidden="true">
  {variant === 'cube' && (
    <svg width={size} height={size} viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="cubeTop" x1="50" y1="10" x2="50" y2="45" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#00f2fe" stop-opacity="0.75" />
          <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.35" />
        </linearGradient>
        <linearGradient id="cubeLeft" x1="15" y1="45" x2="50" y2="90" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#0e3a59" stop-opacity="0.85" />
          <stop offset="100%" stop-color="#061a29" stop-opacity="0.7" />
        </linearGradient>
        <linearGradient id="cubeRight" x1="50" y1="45" x2="85" y2="90" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#144d75" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#08253a" stop-opacity="0.75" />
        </linearGradient>
        <linearGradient id="edgeGlow" x1="15" y1="10" x2="85" y2="90" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="0.9" />
          <stop offset="50%" stop-color="#00f2fe" stop-opacity="0.7" />
          <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.4" />
        </linearGradient>
      </defs>
      <!-- Top Face -->
      <polygon points="50,12 85,32 50,52 15,32" fill="url(#cubeTop)" stroke="url(#edgeGlow)" stroke-width="1.5" />
      <!-- Left Face -->
      <polygon points="15,32 50,52 50,88 15,68" fill="url(#cubeLeft)" stroke="url(#edgeGlow)" stroke-width="1.5" />
      <!-- Right Face -->
      <polygon points="50,52 85,32 85,68 50,88" fill="url(#cubeRight)" stroke="url(#edgeGlow)" stroke-width="1.5" />
      <!-- Specular Highlight Lines -->
      <line x1="50" y1="12" x2="50" y2="52" stroke="#ffffff" stroke-width="1.2" stroke-opacity="0.8" />
      <circle cx="50" cy="52" r="2.5" fill="#00f2fe" filter="drop-shadow(0 0 6px #00f2fe)" />
    </svg>
  )}

  {variant === 'prism' && (
    <svg width={size} height={size} viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="prismFaceA" x1="50" y1="15" x2="20" y2="85" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#00f2fe" stop-opacity="0.65" />
          <stop offset="100%" stop-color="#0a263d" stop-opacity="0.4" />
        </linearGradient>
        <linearGradient id="prismFaceB" x1="50" y1="15" x2="80" y2="85" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.75" />
          <stop offset="100%" stop-color="#071b2c" stop-opacity="0.6" />
        </linearGradient>
      </defs>
      <polygon points="50,15 20,82 50,72" fill="url(#prismFaceA)" stroke="#00f2fe" stroke-width="1.4" stroke-opacity="0.8" />
      <polygon points="50,15 80,82 50,72" fill="url(#prismFaceB)" stroke="#38bdf8" stroke-width="1.4" stroke-opacity="0.9" />
      <line x1="50" y1="15" x2="50" y2="72" stroke="#ffffff" stroke-width="1.8" stroke-opacity="0.9" />
    </svg>
  )}

  {variant === 'diamond' && (
    <svg width={size} height={size} viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <polygon points="50,10 88,50 50,90 12,50" fill="rgba(0, 242, 254, 0.2)" stroke="#00f2fe" stroke-width="1.5" />
      <polygon points="50,25 75,50 50,75 25,50" fill="rgba(14, 40, 64, 0.5)" stroke="#38bdf8" stroke-width="1" />
      <line x1="50" y1="10" x2="50" y2="90" stroke="#ffffff" stroke-width="1" stroke-opacity="0.6" />
      <line x1="12" y1="50" x2="88" y2="50" stroke="#ffffff" stroke-width="1" stroke-opacity="0.6" />
    </svg>
  )}
</div>

<style>
  .prism-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    user-select: none;
    pointer-events: none;
    filter: drop-shadow(0 10px 20px rgba(0, 242, 254, 0.25));
  }
</style>
