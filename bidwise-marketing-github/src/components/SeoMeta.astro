---
import { BRAND_CONFIG } from '../config/brand.config';

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'service';
  schemaData?: any;
}

const {
  title = `${BRAND_CONFIG.name} | Google Ads & PPC Performance Agency`,
  description = BRAND_CONFIG.shortDescription,
  canonicalUrl,
  ogImage = `${BRAND_CONFIG.domain}/logo.png`,
  noindex = false,
  type = 'website',
  schemaData = null,
} = Astro.props;

const siteUrl = BRAND_CONFIG.domain;

// Ensure clean, standardized canonical URL pointing to the production domain with trailing slash
const pathname = Astro.url.pathname;
const cleanPath = pathname.endsWith('/') ? pathname : `${pathname}/`;
const resolvedCanonical = canonicalUrl || `${siteUrl}${cleanPath === '//' ? '/' : cleanPath}`;

// Base Organization and WebSite Schema
const baseSchema: Record<string, any> = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      "name": BRAND_CONFIG.name,
      "alternateName": "BidWise",
      "url": siteUrl,
      "logo": `${siteUrl}/logo.png`,
      "image": `${siteUrl}/logo.png`,
      "description": BRAND_CONFIG.shortDescription,
      "telephone": BRAND_CONFIG.contact.phoneDisplay,
      "email": BRAND_CONFIG.contact.email,
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": BRAND_CONFIG.contact.address.street,
        "addressLocality": BRAND_CONFIG.contact.address.city,
        "addressRegion": BRAND_CONFIG.contact.address.state,
        "postalCode": BRAND_CONFIG.contact.address.postalCode,
        "addressCountry": BRAND_CONFIG.contact.address.countryCode,
      }
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": BRAND_CONFIG.name,
      "description": BRAND_CONFIG.tagline,
      "publisher": {
        "@id": `${siteUrl}/#organization`
      }
    },
    {
      "@type": "WebPage",
      "@id": `${resolvedCanonical}#webpage`,
      "url": resolvedCanonical,
      "name": title,
      "description": description,
      "isPartOf": {
        "@id": `${siteUrl}/#website`
      },
      "inLanguage": "en-US"
    }
  ]
};

// Merge custom schema if provided
if (schemaData) {
  if (Array.isArray(schemaData)) {
    baseSchema["@graph"].push(...schemaData);
  } else {
    baseSchema["@graph"].push(schemaData);
  }
}
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={resolvedCanonical} />
<meta name="google-site-verification" content={BRAND_CONFIG.tracking.googleSiteVerification} />

{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={BRAND_CONFIG.name} />
<meta property="og:locale" content="en_US" />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={resolvedCanonical} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Structured Data JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
