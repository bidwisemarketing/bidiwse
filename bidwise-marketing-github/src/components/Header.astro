---
import { BRAND_CONFIG } from '../config/brand.config';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="header-wrapper">
  <div class="nav-pill-bar" role="navigation" aria-label="Main Navigation">
    <!-- Brand Logo -->
    <a href="/" class="brand-link" aria-label="BidWise Marketing - Homepage">
      <picture>
        <source srcset="/logo-360.webp" type="image/webp" />
        <img 
          src="/logo.png" 
          alt="BidWise Marketing" 
          width="156" 
          height="87" 
          class="brand-logo-img" 
          loading="eager" 
          decoding="async"
        />
      </picture>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="desktop-nav" aria-label="Desktop Primary">
      <ul class="nav-list">
        {BRAND_CONFIG.navigation.main.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <li>
              <a 
                href={item.href} 
                class={`nav-link ${isActive ? 'active' : ''} ${item.highlight ? 'nav-link-highlight' : ''}`}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <!-- WhatsApp Quick Link -->
      <a 
        href={BRAND_CONFIG.contact.whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="whatsapp-quick-btn" 
        title="Direct WhatsApp Chat with BidWise Marketing"
        aria-label="Direct WhatsApp Chat with BidWise Marketing"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
      </a>

      <!-- Primary Action CTA -->
      <a href="/free-google-ads-audit/" class="btn btn-primary btn-sm action-cta">
        Free Ads Audit
      </a>

      <!-- Mobile Hamburger Button -->
      <button 
        id="mobileMenuToggle" 
        class="mobile-toggle" 
        aria-label="Open Navigation Menu" 
        aria-expanded="false" 
        aria-controls="mobileMenuDrawer"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu (Frosted Glass) -->
  <div id="mobileMenuDrawer" class="mobile-drawer" aria-hidden="true">
    <div class="drawer-header">
      <a href="/" class="brand-link" aria-label="BidWise Marketing">
        <img 
          src="/logo.png" 
          alt="BidWise Marketing" 
          width="130" 
          height="72" 
          class="brand-logo-img drawer-logo-img" 
          loading="lazy" 
          decoding="async"
        />
      </a>
      <button id="closeMobileMenu" class="close-drawer-btn" aria-label="Close Navigation Menu">
        ✕
      </button>
    </div>

    <nav class="mobile-nav" aria-label="Mobile Primary">
      <ul class="mobile-nav-list">
        {BRAND_CONFIG.navigation.main.map((item) => (
          <li>
            <a href={item.href} class={`mobile-nav-link ${currentPath === item.href ? 'active' : ''}`}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mobile-drawer-footer">
      <a href="/free-google-ads-audit/" class="btn btn-primary" style="width: 100%;">
        Claim Free Google Ads Audit
      </a>
      <div class="mobile-contact-info">
        <a href={`tel:${BRAND_CONFIG.contact.phoneTel}`} class="mobile-contact-line">
          📞 {BRAND_CONFIG.contact.phoneDisplay}
        </a>
        <a href={`mailto:${BRAND_CONFIG.contact.email}`} class="mobile-contact-line">
          ✉️ {BRAND_CONFIG.contact.email}
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .header-wrapper {
    position: fixed;
    top: 20px;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 100;
    display: flex;
    justify-content: center;
    padding: 0 20px;
    pointer-events: none;
  }

  .nav-pill-bar {
    pointer-events: auto;
    width: 100%;
    max-width: 1120px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px 0 24px;
    background: rgba(6, 18, 30, 0.72);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(0, 242, 254, 0.25);
    border-radius: 9999px;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.15), 0 0 25px rgba(0, 242, 254, 0.08);
    transition: all 0.3s ease;
  }

  .nav-pill-bar:hover {
    border-color: rgba(0, 242, 254, 0.45);
    box-shadow: 0 25px 55px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.25), 0 0 35px rgba(0, 242, 254, 0.15);
  }

  .brand-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-logo-img {
    height: 44px;
    width: auto;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 2px 10px rgba(0, 242, 254, 0.25));
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.3s ease;
  }

  .brand-link:hover .brand-logo-img {
    transform: scale(1.05);
    filter: drop-shadow(0 4px 16px rgba(0, 242, 254, 0.45));
  }

  .drawer-logo-img {
    height: 38px;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
  }

  .nav-link {
    padding: 8px 16px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-muted);
    border-radius: 9999px;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .nav-link:hover {
    color: #ffffff;
    background: rgba(0, 242, 254, 0.1);
    box-shadow: 0 0 15px rgba(0, 242, 254, 0.2);
  }

  .nav-link.active {
    color: #030a10;
    background: #00f2fe;
    font-weight: 700;
    box-shadow: 0 0 20px rgba(0, 242, 254, 0.6);
  }

  .nav-link-highlight {
    color: var(--cyan-bright);
    position: relative;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .whatsapp-quick-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(14, 38, 60, 0.6);
    border: 1px solid rgba(0, 242, 254, 0.25);
    color: #25d366;
    transition: all 0.2s ease;
  }

  .whatsapp-quick-btn:hover {
    border-color: #25d366;
    box-shadow: 0 0 15px rgba(37, 211, 102, 0.4);
    transform: scale(1.05);
  }

  .action-cta {
    border-radius: 9999px;
    padding: 8px 20px;
    font-size: 0.84rem;
  }

  /* Hamburger Menu Toggle */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 38px;
    height: 38px;
    padding: 8px;
    background: rgba(14, 38, 60, 0.6);
    border: 1px solid rgba(0, 242, 254, 0.25);
    border-radius: 50%;
    cursor: pointer;
  }

  .hamburger-bar {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--cyan-primary);
    border-radius: 2px;
    transition: all 0.25s ease;
  }

  /* Mobile Drawer Menu */
  .mobile-drawer {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(4, 12, 20, 0.94);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    z-index: 1000;
    padding: 24px;
    flex-direction: column;
    justify-content: space-between;
    pointer-events: auto;
    overflow-y: auto;
  }

  .mobile-drawer.open {
    display: flex;
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(0, 242, 254, 0.2);
  }

  .close-drawer-btn {
    background: rgba(16, 42, 66, 0.6);
    border: 1px solid rgba(0, 242, 254, 0.3);
    color: #fff;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-size: 1.25rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 32px 0;
  }

  .mobile-nav-link {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-main);
    display: block;
    padding: 10px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    text-decoration: none;
  }

  .mobile-nav-link.active {
    color: var(--cyan-primary);
  }

  .mobile-drawer-footer {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 20px;
    border-top: 1px solid rgba(0, 242, 254, 0.2);
  }

  .mobile-contact-line {
    font-size: 0.9375rem;
    color: var(--text-muted);
    display: block;
    margin-bottom: 6px;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .desktop-nav {
      display: none;
    }
    .action-cta {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
  }
</style>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobileMenuToggle');
    const closeBtn = document.getElementById('closeMobileMenu');
    const drawer = document.getElementById('mobileMenuDrawer');

    if (!toggleBtn || !drawer || !closeBtn) return;

    function openMenu() {
      drawer.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');
      toggleBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      drawer.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      toggleBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    toggleBtn.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('open')) {
        closeMenu();
      }
    });

    const links = drawer.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', closeMenu);
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
