---
import { BRAND_CONFIG } from '../config/brand.config';
import GlassPrism from './GlassPrism.astro';
---

<section class="hero-section">
  <!-- Floating 3D Geometric Glass Prisms in Background -->
  <GlassPrism size={95} variant="cube" className="prism-float hero-prism-1" />
  <GlassPrism size={75} variant="prism" className="prism-float-reverse hero-prism-2" />
  <GlassPrism size={60} variant="diamond" className="prism-float hero-prism-3" />

  <div class="container hero-container">
    <div class="hero-grid">
      <!-- Left Hero Text Content -->
      <div class="hero-content">
        <div class="glass-pill hero-badge">
          <span class="dot"></span>
          <span>Google Partner &bull; Full-Service Growth Agency</span>
        </div>

        <h1 class="hero-title">
          Smarter Marketing.<br />
          <span class="text-gradient">Predictable Revenue.</span>
        </h1>

        <p class="hero-description">
          We combine high-intent Google Ads, multi-channel paid social, AEO/GEO search authority, high-converting web engineering, and automated AI workflows to scale your business with mathematical precision.
        </p>

        <!-- CTA Action Buttons -->
        <div class="hero-cta-group">
          <a href="/free-google-ads-audit/" class="btn btn-primary hero-btn-main">
            <span>Claim Free Google Ads Audit</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="/services/" class="btn btn-glass hero-btn-sub">
            Explore Services
          </a>
        </div>

        <!-- Verified Credibility Metrics Strip -->
        <div class="hero-proof-strip">
          <div class="proof-item">
            <span class="proof-number">9+</span>
            <span class="proof-label">Years of PPC Experience</span>
          </div>
          <div class="proof-divider"></div>
          <div class="proof-item">
            <span class="proof-number">700+</span>
            <span class="proof-label">Clients Scaled</span>
          </div>
          <div class="proof-divider"></div>
          <div class="proof-item">
            <span class="proof-number">6.8x</span>
            <span class="proof-label">Average Target ROAS</span>
          </div>
        </div>
      </div>

      <!-- Right Hero Visual with Verified Founder & Floating Glass Widgets (matching reference design) -->
      <div class="hero-visual-wrapper">
        <div class="hero-visual-halo"></div>

        <!-- Main Showcase (Seamless Blended Visual, No Square Box) -->
        <div class="founder-showcase-wrapper">
          <div class="founder-image-container">
            <picture>
              <source media="(max-width: 640px)" srcset="/hero-portrait-mobile.webp" type="image/webp" />
              <source srcset="/hero-portrait.webp" type="image/webp" />
              <img 
                src={BRAND_CONFIG.founder.image} 
                alt="Certified Google Partner & Senior PPC Specialist at BidWise Marketing" 
                width="1024"
                height="906"
                class="founder-portrait"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
            <div class="founder-overlay-gradient"></div>
          </div>

          <!-- Floating Glass HUD Card for Name & Intent Meter -->
          <div class="glass-card founder-hud-card">
            <div class="founder-meta">
              <div class="founder-identity">
                <span class="founder-name">Senior PPC &amp; Growth Team</span>
                <span class="founder-tag">Google Partner Certified Specialists</span>
              </div>
              <a href="/contact/" class="btn btn-primary btn-sm quick-inquire-btn">
                Consult Now &rarr;
              </a>
            </div>

            <!-- Progress / Audit Bar inside HUD Card -->
            <div class="audit-meter-container">
              <div class="audit-meter-header">
                <span class="meter-title">Search Intent Purity Index</span>
                <span class="meter-score text-cyan">98.4% Optimal</span>
              </div>
              <div class="audit-progress-track">
                <div class="audit-progress-bar" style="width: 98.4%;"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating Glass Widget A: Real-time ROAS Tracker -->
        <div class="glass-card floating-widget floating-widget-top" aria-hidden="true">
          <div class="widget-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#00f2fe" stroke-width="2">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
              <polyline points="17 6 23 6 23 12"></polyline>
            </svg>
          </div>
          <div class="widget-text">
            <span class="widget-label">Portfolio Blended ROAS</span>
            <span class="widget-value text-cyan">6.84x Scaled</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: calc(var(--nav-height) + 60px);
    padding-bottom: 70px;
    overflow: hidden;
  }

  .hero-prism-1 {
    top: 14%;
    left: 4%;
  }

  .hero-prism-2 {
    bottom: 12%;
    right: 3%;
  }

  .hero-prism-3 {
    top: 48%;
    left: 45%;
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.95fr;
    gap: 48px;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hero-badge {
    align-self: flex-start;
  }

  .hero-title {
    line-height: 1.1;
  }

  .hero-description {
    font-size: 1.125rem;
    color: var(--text-muted);
    max-width: 580px;
    line-height: 1.7;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 10px;
    flex-wrap: wrap;
  }

  .hero-btn-main {
    padding: 15px 30px;
    font-size: 1rem;
    border-radius: 9999px;
  }

  .hero-btn-sub {
    padding: 15px 28px;
    font-size: 1rem;
    border-radius: 9999px;
  }

  .hero-proof-strip {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .proof-item {
    display: flex;
    flex-direction: column;
  }

  .proof-number {
    font-size: 1.65rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .proof-label {
    font-size: 0.8125rem;
    color: var(--text-dim);
    font-weight: 500;
  }

  .proof-divider {
    width: 1px;
    height: 36px;
    background: rgba(0, 242, 254, 0.2);
  }

  /* Right Side Hero Visual */
  .hero-visual-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-visual-halo {
    position: absolute;
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(0, 242, 254, 0.22) 0%, rgba(20, 184, 166, 0.1) 45%, transparent 70%);
    border-radius: 50%;
    filter: blur(40px);
    pointer-events: none;
    z-index: 0;
  }

  .founder-showcase-wrapper {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .founder-image-container {
    position: relative;
    width: 100%;
    aspect-ratio: 1024 / 906;
    border: none;
    background: transparent;
    overflow: visible;
  }

  .founder-portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: contrast(1.05) brightness(1.02);
    /* Organic feathered mask blending the portrait completely into the homepage */
    -webkit-mask-image: radial-gradient(ellipse 82% 78% at 50% 46%, #000 46%, rgba(0, 0, 0, 0.72) 66%, transparent 92%);
    mask-image: radial-gradient(ellipse 82% 78% at 50% 46%, #000 46%, rgba(0, 0, 0, 0.72) 66%, transparent 92%);
  }

  .founder-overlay-gradient {
    position: absolute;
    bottom: -5px;
    left: 0;
    right: 0;
    height: 110px;
    background: linear-gradient(to top, rgba(3, 8, 14, 0.98) 0%, rgba(3, 8, 14, 0.6) 60%, transparent 100%);
    pointer-events: none;
  }

  .founder-hud-card {
    position: relative;
    z-index: 2;
    width: 100%;
    margin-top: -30px;
    padding: 18px 22px;
    border-radius: 22px;
    background: rgba(8, 22, 38, 0.8);
    border: 1px solid rgba(0, 242, 254, 0.25);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 0 35px rgba(0, 242, 254, 0.12);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .founder-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .founder-identity {
    display: flex;
    flex-direction: column;
  }

  .founder-name {
    font-size: 1.15rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .founder-tag {
    font-size: 0.78rem;
    color: var(--cyan-bright);
    font-weight: 600;
  }

  .quick-inquire-btn {
    border-radius: 9999px;
    padding: 6px 14px;
    font-size: 0.78rem;
  }

  /* Progress track inside card */
  .audit-meter-container {
    margin-top: 14px;
  }

  .audit-meter-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .meter-title {
    color: var(--text-muted);
  }

  .audit-progress-track {
    width: 100%;
    height: 6px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    overflow: hidden;
  }

  .audit-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #00f2fe 0%, #38bdf8 100%);
    box-shadow: 0 0 10px #00f2fe;
    border-radius: 9999px;
  }

  /* Floating Overlay Glass Widgets */
  .floating-widget {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    border-radius: 16px;
    z-index: 2;
    background: rgba(10, 26, 44, 0.75);
    border: 1px solid rgba(0, 242, 254, 0.3);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .floating-widget-top {
    top: 15px;
    right: -25px;
    z-index: 3;
    animation: floatPrism 6s ease-in-out infinite alternate;
  }

  .widget-icon-box {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(0, 242, 254, 0.12);
    border: 1px solid rgba(0, 242, 254, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .widget-text {
    display: flex;
    flex-direction: column;
  }

  .widget-label {
    font-size: 0.72rem;
    color: var(--text-dim);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .widget-value {
    font-size: 0.88rem;
    font-weight: 700;
    color: #ffffff;
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 60px;
      text-align: center;
    }
    .hero-badge {
      align-self: center;
    }
    .hero-description {
      margin: 0 auto;
    }
    .hero-cta-group {
      justify-content: center;
    }
    .hero-proof-strip {
      justify-content: center;
    }
    .floating-widget-top {
      right: 0;
    }
  }

  @media (max-width: 640px) {
    .founder-image-container {
      height: 280px;
    }
    .floating-widget {
      display: none;
    }
    .hero-proof-strip {
      flex-direction: column;
      gap: 16px;
    }
    .proof-divider {
      display: none;
    }
  }
</style>
