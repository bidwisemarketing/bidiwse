---
const skills = [
  { name: 'Google Ads', category: 'PPC & Search', icon: '🎯', color: '#4285f4' },
  { name: 'Performance Max', category: 'Smart Bidding', icon: '⚡', color: '#00f2fe' },
  { name: 'Meta Ads', category: 'Paid Social', icon: '♾️', color: '#0668e1' },
  { name: 'TikTok Ads', category: 'Short Video', icon: '🎵', color: '#ff0050' },
  { name: 'LinkedIn Ads', category: 'B2B Pipeline', icon: '💼', color: '#0a66c2' },
  { name: 'Google Tag Manager', category: 'Telemetry', icon: '🏷️', color: '#246fdb' },
  { name: 'GA4 Analytics', category: 'Attribution', icon: '📊', color: '#f9ab00' },
  { name: 'n8n & AI Workflows', category: 'Automation', icon: '🤖', color: '#ea4b71' },
  { name: 'Target CPA & ROAS', category: 'Bid Optimization', icon: '🎯', color: '#10b981' },
  { name: 'Astro & Next.js', category: 'Ultra-Fast Web', icon: '🚀', color: '#38bdf8' },
  { name: 'Shopify & GMC', category: 'Ecommerce Feeds', icon: '🛍️', color: '#95bf47' },
  { name: 'Klaviyo Lifecycle', category: 'Retention & Email', icon: '✉️', color: '#ff6f61' }
];
---

<div class="glass-card skills-glass-card">
  <div class="skills-card-header">
    <div class="glass-pill">
      <span class="dot"></span>
      <span>Platforms &amp; Tooling</span>
    </div>
    <h3 class="skills-card-title">Technical Mastery &amp; Certified Stacks</h3>
    <p class="skills-card-desc">
      We operate directly in native ad consoles, cloud servers, and modern development frameworks to maintain total control over your growth pipeline.
    </p>
  </div>

  <div class="hex-grid">
    {skills.map((skill) => (
      <div class="hex-badge-card">
        <div class="hex-shape">
          <span class="hex-icon">{skill.icon}</span>
        </div>
        <div class="hex-content">
          <span class="hex-name">{skill.name}</span>
          <span class="hex-cat">{skill.category}</span>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .skills-glass-card {
    padding: 40px;
    background: rgba(8, 22, 38, 0.68);
    border: 1px solid rgba(0, 242, 254, 0.25);
  }

  .skills-card-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 36px auto;
  }

  .skills-card-title {
    font-size: 1.6rem;
    color: #ffffff;
    margin: 14px 0 8px 0;
  }

  .skills-card-desc {
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .hex-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .hex-badge-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    background: rgba(12, 30, 48, 0.55);
    border: 1px solid rgba(0, 242, 254, 0.16);
    border-radius: 16px;
    backdrop-filter: blur(12px);
    transition: all 0.25s ease;
  }

  .hex-badge-card:hover {
    background: rgba(16, 40, 64, 0.75);
    border-color: rgba(0, 242, 254, 0.5);
    box-shadow: 0 10px 25px rgba(0, 242, 254, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transform: translateY(-3px);
  }

  .hex-shape {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(6, 18, 30, 0.8);
    border: 1px solid rgba(0, 242, 254, 0.3);
    box-shadow: 0 0 12px rgba(0, 242, 254, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .hex-icon {
    font-size: 1.25rem;
  }

  .hex-content {
    display: flex;
    flex-direction: column;
  }

  .hex-name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #ffffff;
  }

  .hex-cat {
    font-size: 0.75rem;
    color: var(--cyan-bright);
    font-weight: 500;
  }

  @media (max-width: 1024px) {
    .hex-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hex-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .skills-glass-card {
      padding: 24px;
    }
  }

  @media (max-width: 480px) {
    .hex-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
