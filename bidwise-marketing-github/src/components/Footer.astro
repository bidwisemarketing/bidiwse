---
import { BRAND_CONFIG } from '../config/brand.config';
---

<footer class="footer-section">
  <div class="container">
    <div class="glass-card footer-card">
      <div class="footer-grid">
        <!-- Brand & Description -->
        <div class="footer-brand-col">
          <a href="/" class="footer-brand-link" aria-label="BidWise Marketing Homepage">
            <picture>
              <source srcset="/logo-180.webp" type="image/webp" />
              <img 
                src="/logo.png" 
                alt="BidWise Marketing" 
                width="156" 
                height="87" 
                class="footer-brand-logo-img" 
                loading="lazy" 
                decoding="async"
              />
            </picture>
          </a>
          <p class="footer-desc">
            Full-service digital growth agency engineered for measurable ROI. Certified Google Partner agency with 9+ years of dedicated optimization experience.
          </p>

          <div class="verified-partner-badge">
            <span class="badge-icon">✓</span>
            <span>Google Partner Certified &amp; GTM Accredited</span>
          </div>
        </div>

        <!-- Service Pillars -->
        <div class="footer-links-col">
          <h3 class="footer-col-title">Growth &amp; Media</h3>
          <ul class="footer-nav-list">
            <li><a href="/services/paid-advertising/">Paid Advertising Hub</a></li>
            <li><a href="/services/google-ads/">Google Ads Management</a></li>
            <li><a href="/services/meta-ads/">Meta Ads (FB &amp; IG)</a></li>
            <li><a href="/services/tiktok-ads/">TikTok Ads</a></li>
            <li><a href="/services/linkedin-ads/">LinkedIn B2B Ads</a></li>
          </ul>
        </div>

        <div class="footer-links-col">
          <h3 class="footer-col-title">Search &amp; Tech</h3>
          <ul class="footer-nav-list">
            <li><a href="/services/seo/">Technical &amp; Organic SEO</a></li>
            <li><a href="/services/aeo-geo/">AEO &amp; GEO (AI Search)</a></li>
            <li><a href="/services/web-design/">Web Design &amp; Dev</a></li>
            <li><a href="/services/ai-automation/">AI Business Automations</a></li>
            <li><a href="/services/analytics-tracking/">Analytics &amp; Tracking</a></li>
          </ul>
        </div>

        <!-- Verified Contact Details -->
        <div class="footer-contact-col">
          <h3 class="footer-col-title">Company &amp; Contact</h3>
          <address class="footer-address">
            <p class="contact-item">
              <span class="contact-icon">🏢</span>
              <span><strong>Company:</strong> {BRAND_CONFIG.legalName}</span>
            </p>
            <p class="contact-item">
              <span class="contact-icon">📍</span>
              <span>{BRAND_CONFIG.contact.address.street}, {BRAND_CONFIG.contact.address.city}, {BRAND_CONFIG.contact.address.state} {BRAND_CONFIG.contact.address.postalCode}, {BRAND_CONFIG.contact.address.country}</span>
            </p>
            <p class="contact-item">
              <span class="contact-icon">📞</span>
              <a href={`tel:${BRAND_CONFIG.contact.phoneTel}`} class="contact-link">{BRAND_CONFIG.contact.phoneDisplay}</a>
            </p>
            <p class="contact-item">
              <span class="contact-icon">✉️</span>
              <a href={`mailto:${BRAND_CONFIG.contact.email}`} class="contact-link">{BRAND_CONFIG.contact.email}</a>
            </p>
            <p class="contact-item">
              <span class="contact-icon">💬</span>
              <a href={BRAND_CONFIG.contact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="contact-link">WhatsApp: +1 302 626 7596</a>
            </p>
            <p class="contact-item">
              <span class="contact-icon">⏱️</span>
              <span>{BRAND_CONFIG.contact.hours}</span>
            </p>
          </address>
        </div>
      </div>

      <!-- Bottom Bar -->
      <div class="footer-bottom">
        <p class="copyright">
          &copy; {new Date().getFullYear()} {BRAND_CONFIG.legalName}. All rights reserved.
        </p>
        <div class="legal-links">
          <a href="/privacy/">Privacy Policy</a>
          <span class="separator">&bull;</span>
          <a href="/terms/">Terms of Service</a>
          <span class="separator">&bull;</span>
          <a href="/cookies/">Cookie Policy</a>
          <span class="separator">&bull;</span>
          <a href="/free-google-ads-audit/">Free Ads Audit</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-section {
    padding: 60px 0 40px 0;
    position: relative;
    z-index: 10;
  }

  .footer-card {
    background: rgba(6, 18, 30, 0.75);
    border: 1px solid rgba(0, 242, 254, 0.2);
    border-radius: 24px;
    padding: 48px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.6fr;
    gap: 40px;
    margin-bottom: 48px;
  }

  .footer-brand-link {
    display: inline-flex;
    align-items: center;
    margin-bottom: 20px;
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .footer-brand-logo-img {
    height: 58px;
    width: auto;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 3px 12px rgba(0, 242, 254, 0.22));
    transition: filter 0.3s ease, transform 0.3s ease;
  }

  .footer-brand-link:hover .footer-brand-logo-img {
    transform: scale(1.04);
    filter: drop-shadow(0 6px 20px rgba(0, 242, 254, 0.45));
  }

  .footer-desc {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 20px;
    max-width: 320px;
  }

  .verified-partner-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(0, 242, 254, 0.08);
    border: 1px solid rgba(0, 242, 254, 0.25);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--cyan-primary);
  }

  .badge-icon {
    font-weight: bold;
  }

  .footer-col-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 18px;
  }

  .footer-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-nav-list a {
    font-size: 0.875rem;
    color: var(--text-muted);
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .footer-nav-list a:hover {
    color: var(--cyan-primary);
    transform: translateX(3px);
  }

  .footer-address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .contact-item {
    font-size: 0.875rem;
    color: var(--text-muted);
    display: flex;
    align-items: flex-start;
    gap: 10px;
    line-height: 1.5;
  }

  .contact-icon {
    font-size: 1rem;
    flex-shrink: 0;
  }

  .contact-link {
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .contact-link:hover {
    color: var(--cyan-primary);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
    gap: 16px;
  }

  .copyright {
    font-size: 0.84rem;
    color: var(--text-dim);
  }

  .legal-links {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.84rem;
  }

  .legal-links a {
    color: var(--text-dim);
    transition: color 0.2s ease;
  }

  .legal-links a:hover {
    color: var(--cyan-primary);
  }

  .separator {
    color: var(--text-dim);
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
    .footer-card {
      padding: 32px;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
